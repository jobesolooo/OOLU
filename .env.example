# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (https://dashboard.stripe.com/test/apikeys) ─
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# or the webhook endpoint you create in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_...
# Set to "true" once Stripe Tax is enabled on the account
STRIPE_AUTOMATIC_TAX=false

# ── Shipping (amounts in cents) ───────────────────────
# Prices are in euros (cents). Change both to sell in another currency.
STORE_CURRENCY=eur
NEXT_PUBLIC_STORE_CURRENCY=eur
FREE_SHIPPING_THRESHOLD=10000
FLAT_SHIPPING_RATE=800
# ISO country codes you ship to, comma-separated (blank = worldwide default list)
SHIPPING_COUNTRIES=

# ── Database ──────────────────────────────────────────
# Leave blank in local dev to use the built-in embedded Postgres (./.data).
# Required in production (Neon, Supabase, Vercel Postgres, ...).
DATABASE_URL=

# ── Sessions / auth ───────────────────────────────────
# At least 32 random characters: `openssl rand -base64 32`
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Accounts with these emails get the admin dashboard (comma-separated)
ADMIN_EMAILS=

# ── Email (https://resend.com) ────────────────────────
# Leave blank to log emails to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="OOLU <orders@ooluclothing.shop>"
# Where new-order alerts go
ORDER_NOTIFICATION_EMAIL=

# ── Extras ────────────────────────────────────────────
# Protects /api/cron/drops (Vercel sends it automatically when set in project env)
CRON_SECRET=
# Days customers have to request a return
RETURN_WINDOW_DAYS=30
# Shown in the "return approved" email. Use | for line breaks.
RETURN_ADDRESS="OOLU Returns|Street 1|1000 AA Amsterdam|Netherlands"

# ── Sign in with Google ───────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sign in with Apple ────────────────────────────────
# developer.apple.com → Certificates, IDs & Profiles (needs a paid Apple Developer account)
# APPLE_CLIENT_ID is the Services ID (e.g. shop.ooluclothing.web), not the App ID.
# Return URL: <NEXT_PUBLIC_SITE_URL>/api/auth/apple/callback  (must be https — Apple rejects localhost)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key file. Paste on one line with \n for line breaks, or as a quoted multi-line value.
APPLE_PRIVATE_KEY=
